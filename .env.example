# ─── Heroku app name ───
# HEROKU_APP_NAME=openclaw-yourname

# ─── Required: AI provider ───
OPENROUTER_API_KEY=sk-or-...

# ─── Auth (strongly recommended) ───
AUTH_PASSWORD=your-strong-password
AUTH_USERNAME=admin

# ─── Gateway ───
OPENCLAW_GATEWAY_TOKEN=generate-with-openssl-rand-hex-32

# ─── Channels (pick one or more) ───
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_DM_POLICY=pairing
# DISCORD_BOT_TOKEN=...
# DISCORD_DM_POLICY=pairing
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# ─── Model override (optional) ───
# OPENCLAW_PRIMARY_MODEL=openrouter/anthropic/claude-sonnet-4-5-20250929

# ─── Heroku sets this automatically, don't touch ───
# PORT=8080
